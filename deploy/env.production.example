# Copy to .env.production only on the deployment server.
# Never commit the populated file or paste its secret values into logs/chat.

COMPOSE_PROJECT_NAME=liema
LIEMA_IMAGE=liema-auto:2026.08.22
LIEMA_WEB_BIND=127.0.0.1
LIEMA_WEB_PORT=8080
# false for trusted-LAN HTTP; set true when the public URL uses HTTPS.
LIEMA_SESSION_COOKIE_SECURE=false

LIEMA_MASTER_KEY=

LIEMA_MYSQL_HOST=
LIEMA_MYSQL_PORT=3306
LIEMA_MYSQL_DATABASE=
LIEMA_MYSQL_USER=
LIEMA_MYSQL_PASSWORD=

LIEMA_MINIO_ENDPOINT=
LIEMA_MINIO_ACCESS_KEY=
LIEMA_MINIO_SECRET_KEY=
LIEMA_MINIO_BUCKET=
LIEMA_MINIO_SECURE=false

LIEMA_REDIS_HOST=
LIEMA_REDIS_PORT=6379
LIEMA_REDIS_NAMESPACE=liema-auto
LIEMA_REDIS_USERNAME=
# Production should set an ACL password. Leave empty only for an explicitly
# approved temporary deployment against an isolated/trusted-network Redis.
LIEMA_REDIS_PASSWORD=
