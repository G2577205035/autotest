ARG CUDA_VERSION=11.8.0
ARG IMAGE_DISTRO=ubi8

FROM nvidia/cuda:${CUDA_VERSION}-runtime-${IMAGE_DISTRO}

COPY gpu_burn compare.fatbin /app/

WORKDIR /app

LABEL org.opencontainers.image.title="xiaoyi gpu-burn"
LABEL org.opencontainers.image.description="Multi-architecture gpu-burn runtime with native sm_75/sm_80/sm_86/sm_89 and compute_89 PTX fallback"

ENTRYPOINT ["./gpu_burn"]
CMD ["60"]
