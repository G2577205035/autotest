FROM python:3.12-slim AS fonts

COPY vendor/fonts/fonts-noto-cjk.deb /tmp/fonts-noto-cjk.deb
RUN mkdir -p /font-root \
    && dpkg-deb --extract /tmp/fonts-noto-cjk.deb /font-root

FROM python:3.12-slim AS builder

WORKDIR /build
COPY vendor/wheels /wheels
COPY pyproject.toml README.md ./
COPY src ./src
RUN python -m pip install \
        --no-cache-dir \
        --no-index \
        --find-links=/wheels \
        setuptools wheel \
    && python -m pip install \
        --no-cache-dir \
        --no-index \
        --find-links=/wheels \
        --no-build-isolation \
        --ignore-installed \
        --prefix=/install \
        .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp/matplotlib

WORKDIR /app
COPY --from=fonts /font-root/usr/share/fonts /usr/share/fonts
COPY --from=builder /install /usr/local
COPY config/config.example.yml /app/config/config.example.yml

RUN useradd --create-home --uid 10001 liema \
    && mkdir -p /app/config /app/data /app/runtime /app/artifacts /app/instance /app/logs \
    && chown -R liema:liema /app

USER liema
CMD ["auto-test-web", "--host", "0.0.0.0", "--port", "8080"]
